---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivateSignalHome from '../components/directions/PrivateSignalHome.astro';
import { graph, organizationSchema, personSchema, websiteSchema, webPageSchema } from '../lib/schema';

const brandEntry = await getEntry('brand', 'priya-raghavan');
if (!brandEntry) throw new Error('Private Signal demo brand not found.');
const brand = brandEntry.data;
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');

const brandForSchema = {
  person: {
    name: brand.name,
    jobTitle: brand.title,
    tagline: brand.tagline,
    bio: brand.positioning.promise,
    knowsAbout: [brand.positioning.audience, brand.positioning.differentiator].filter(Boolean),
    portraitUrl: brand.assets.portrait?.src,
    awards: brand.proof.awards.map((award) => award.name),
  },
  organization: brand.company ? { name: brand.company.name, legalName: brand.legal.entity, email: brand.contact.email, telephone: brand.contact.phone } : undefined,
  social: brand.social.map((item) => ({ platform: item.platform, url: item.href })),
  site: { url: `${siteUrl}/`, name: brand.name },
};

const schema = graph([
  personSchema(brandForSchema),
  organizationSchema(brandForSchema),
  websiteSchema(brandForSchema),
  webPageSchema({ brand: brandForSchema, url: `${siteUrl}/`, title: 'Priya Raghavan | Private Signal', description: 'A premium conceptual executive authority experience built around private signal and considered presence.', breadcrumbs: [{ name: 'Home', url: `${siteUrl}/` }] }),
]);
---

<BaseLayout {brand} title="Priya Raghavan | Private Signal" description="A premium conceptual executive authority experience built around private signal, permissioned proof and considered presence." ogImage="/images/private-signal-hero.webp" {schema} transparentHeader={true} bodyClass="private-signal">
  <PrivateSignalHome />
</BaseLayout>

<style>
  :global(.private-signal) { --surface:#0c0a08; --surface-raised:#17120e; --text:#f7f0df; --text-muted:#d5cbb7; --text-subtle:#a99e8c; --accent:#d7bc7a; --border:rgba(215,188,122,.38); --card-bg:#17120e; background:#0c0a08; color:#f7f0df; }
  :global(.private-signal .ahd) { position:absolute; inset:0 0 auto; z-index:20; background:linear-gradient(180deg,rgba(8,6,5,.65),transparent); color:#f7f0df; border-bottom:1px solid rgba(215,188,122,.25); }
  :global(.private-signal .ahd[data-scrolled='true']) { position:sticky; background:rgba(12,10,8,.93); backdrop-filter:blur(14px); border-bottom-color:rgba(215,188,122,.32); }
  :global(.private-signal .ahd__wordmark), :global(.private-signal .ahd__nav a) { color:#f7f0df; }
  :global(.private-signal .ahd__nav a:hover), :global(.private-signal .ahd__nav a[data-active='true']) { color:#d7bc7a; }
  :global(.private-signal .ahd__toggle span) { background:#f7f0df; }
  :global(.private-signal .ahd__cta) { border-color:#d7bc7a; border-radius:0; background:#d7bc7a; color:#18130b; }
  :global(.private-signal .site-footer) { background:#0c0a08; }

</style>
