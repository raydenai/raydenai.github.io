---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const brand = (await getCollection('brand'))[0].data;
---

<BaseLayout {brand} title="Idea Studio — AURA Direction 03" description="Concept direction: an editorial idea-studio site for authors and strategic thinkers." transparentHeader={false} bodyClass="direction direction--studio">
  <section class="is-hero"><div class="is-hero__bar"><span>AURA</span><span>Idea Studio / 03</span><span>Field notes for people with a point of view</span></div><div class="is-hero__grid"><div class="is-hero__copy"><p>Not a personal brand.</p><h1>A <em>point</em><br />of view<br />with a<br /><i>home.</i></h1><p class="is-deck">For the strategist whose ideas become useful only when another person can find them, understand them, and pass them forward.</p><a href="#voices">Read the room <span>↓</span></a></div><figure class="is-hero__portrait"><img src="/images/portrait-seated.webp" alt="Conceptual personal-brand strategist seated in a calm editorial setting" width="1200" height="1500" /><figcaption>Portraits appear as a human counterpoint to the idea—not the entire proposition.</figcaption></figure></div><div class="is-hero__rule"></div></section>

  <section id="voices" class="is-voices"><header><p class="is-kicker">The unedited question</p><h2>The thing capable<br />people say quietly.</h2></header><div class="is-voices__cards"><blockquote><span>01</span><p>“I know the work is good. I do not know why nobody can explain it in a sentence.”</p><footer>Founder, series B software company</footer></blockquote><blockquote><span>02</span><p>“We have a thousand slides and no point of view.”</p><footer>Chief strategy officer, global services firm</footer></blockquote><blockquote><span>03</span><p>“Every time I describe what I do, it becomes less clear.”</p><footer>Independent advisor</footer></blockquote></div></section>

  <section class="is-response"><div class="is-response__image"><img src="/images/portrait-story.webp" alt="Conceptual strategist working in an editorial environment" width="1600" height="1000" /></div><div class="is-response__copy"><p class="is-kicker">A different way to work</p><h2>Good ideas do not need more content.<br />They need a <em>shape.</em></h2><p>That shape gives an idea a name, a sequence, a visual grammar, and a way to live outside the person who first had it. The work is part writing, part strategy, part editorial direction.</p><a href="#editions">See the editions <span>→</span></a></div></section>

  <section id="editions" class="is-editions"><header><p class="is-kicker">The editions</p><h2>One body of work.<br />Multiple ways in.</h2></header><div class="is-editions__grid"><article><span>Edition 01</span><h3>The named method</h3><p>A compact operating system for the one thing the expert sees that others do not.</p><a href="#">Open the method ↗</a></article><article><span>Edition 02</span><h3>The evidence library</h3><p>Cases, statements, and results arranged to make the record easy to believe.</p><a href="#">Read the evidence ↗</a></article><article><span>Edition 03</span><h3>The useful artifact</h3><p>A book, diagnostic, field note, or keynote that carries the thinking without a sales call.</p><a href="#">Find the artifact ↗</a></article></div></section>

  <section class="is-notes"><div><p class="is-kicker">Notes from the studio</p><h2>Three decisions<br />before any layout.</h2></div><ol><li><span>A</span><div><h3>Who needs this idea?</h3><p>Not everyone. The exact room where the work becomes valuable.</p></div></li><li><span>B</span><div><h3>What does the room call the problem?</h3><p>Use their words before introducing your method.</p></div></li><li><span>C</span><div><h3>What evidence makes the idea safe to act on?</h3><p>Make the claim specific enough to survive the next question.</p></div></li></ol></section>

  <section class="is-end"><p class="is-kicker">Make the work legible</p><h2>Give your best<br />thinking a form.</h2><a href="/contact/">Begin a studio conversation ↗</a></section>
</BaseLayout>

<style>
  :global(.direction--studio) { --ink:#1b2420; --paper:#fbf7ed; --sage:#b5c49c; --coral:#e06e4b; --line:#27352f; background:var(--paper); color:var(--ink); } :global(.direction--studio .announcement-bar) { display:none; } :global(.direction--studio .site-header) { border-bottom:1px solid var(--line); background:var(--paper); color:var(--ink); } :global(.direction--studio .site-header a) { color:var(--ink); } :global(.direction--studio .site-footer) { background:var(--ink); }
  .is-hero { overflow:hidden; background:var(--paper); } .is-hero__bar { display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem; padding:.85rem clamp(1rem,3vw,3.3rem); border-bottom:1px solid var(--line); font-family:var(--font-display); font-size:.59rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; } .is-hero__bar span:nth-child(2) { text-align:center; color:#647068; } .is-hero__bar span:last-child { text-align:right; color:#647068; }
  .is-hero__grid { display:grid; grid-template-columns:1.1fr .9fr; min-height:calc(100svh - 8rem); } .is-hero__copy { position:relative; padding:clamp(4rem,9vw,10rem) clamp(1.25rem,6vw,7rem); } .is-hero__copy > p:first-child,.is-kicker { margin:0; color:#647068; font-family:var(--font-display); font-size:.65rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; } .is-hero h1,.is-voices h2,.is-response h2,.is-editions h2,.is-notes h2,.is-end h2 { margin:1.5rem 0 0; font-family:var(--font-serif); font-size:clamp(4rem,9vw,10.5rem); font-weight:400; line-height:.77; letter-spacing:-.085em; } .is-hero h1 em { color:var(--coral); } .is-hero h1 i,.is-response h2 em { color:var(--sage); font-family:var(--font-display); font-style:normal; font-weight:800; letter-spacing:-.1em; } .is-deck { max-width:29rem; margin:2.5rem 0 0; color:#435049; font-size:1.05rem; line-height:1.75; } .is-hero__copy a,.is-response__copy a,.is-end a { display:inline-block; margin-top:2rem; color:var(--ink); border-bottom:1px solid var(--ink); padding-bottom:.35rem; font-family:var(--font-display); font-size:.68rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; } .is-hero__copy a:hover,.is-response__copy a:hover,.is-end a:hover { color:var(--coral); border-color:var(--coral); } .is-hero__portrait { position:relative; margin:0; overflow:hidden; background:var(--sage); } .is-hero__portrait img { width:100%; height:100%; object-fit:cover; object-position:center; mix-blend-mode:multiply; filter:contrast(1.05) saturate(.8); } .is-hero__portrait figcaption { position:absolute; bottom:1.4rem; left:1.4rem; max-width:15rem; font-size:.68rem; line-height:1.5; } .is-hero__rule { height:1rem; margin:0 clamp(1rem,3vw,3.3rem); background:var(--coral); }
  .is-voices { padding:clamp(5rem,11vw,11rem) clamp(1.25rem,6vw,7rem); background:var(--ink); color:var(--paper); } .is-voices .is-kicker { color:var(--sage); } .is-voices h2 { max-width:8ch; font-size:clamp(3rem,6.5vw,7.5rem); } .is-voices__cards { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-5); margin-top:clamp(3rem,7vw,7rem); } .is-voices blockquote { display:grid; align-content:space-between; min-height:19rem; margin:0; padding:1.4rem; background:#26332e; } .is-voices blockquote span { color:var(--sage); font-family:var(--font-display); font-size:.72rem; font-weight:800; } .is-voices blockquote p { margin:2rem 0; font-family:var(--font-serif); font-size:1.65rem; line-height:1.05; letter-spacing:-.04em; } .is-voices blockquote footer { color:#b9c0ba; font-family:var(--font-display); font-size:.58rem; font-weight:800; letter-spacing:.11em; text-transform:uppercase; }
  .is-response { display:grid; grid-template-columns:.9fr 1.1fr; min-height:43rem; } .is-response__image { background:var(--coral); } .is-response__image img { width:100%; height:100%; object-fit:cover; mix-blend-mode:multiply; filter:saturate(.75) contrast(1.06); } .is-response__copy { display:grid; align-content:center; padding:clamp(4rem,9vw,10rem); } .is-response h2 { max-width:11ch; font-size:clamp(2.8rem,5.3vw,6.4rem); line-height:.9; } .is-response h2 em { color:var(--coral); } .is-response__copy > p:not(.is-kicker) { max-width:35rem; margin:2rem 0 0; color:#435049; font-size:1.05rem; line-height:1.75; }
  .is-editions { padding:clamp(5rem,11vw,11rem) clamp(1.25rem,6vw,7rem); background:#e8e0ce; } .is-editions h2 { max-width:9ch; font-size:clamp(3rem,6vw,7rem); } .is-editions__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; margin-top:clamp(3.5rem,7vw,7rem); border:1px solid var(--line); background:var(--line); } .is-editions article { min-height:23rem; display:grid; align-content:start; padding:1.5rem; background:#e8e0ce; } .is-editions article span { color:var(--coral); font-family:var(--font-display); font-size:.62rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; } .is-editions h3 { margin:clamp(5rem,10vw,10rem) 0 0; font-family:var(--font-serif); font-size:2.7rem; font-weight:400; letter-spacing:-.06em; line-height:.95; } .is-editions article p { color:#526057; line-height:1.65; } .is-editions article a { margin-top:auto; color:var(--ink); font-family:var(--font-display); font-size:.63rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .is-notes { display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(3rem,10vw,11rem); padding:clamp(5rem,11vw,11rem) clamp(1.25rem,6vw,7rem); } .is-notes h2 { max-width:8ch; font-size:clamp(3rem,5.5vw,6.2rem); } .is-notes ol { display:grid; gap:0; border-top:1px solid var(--line); } .is-notes li { display:grid; grid-template-columns:3rem 1fr; gap:1rem; padding:1.5rem 0; border-bottom:1px solid var(--line); } .is-notes li > span { color:var(--coral); font-family:var(--font-serif); font-size:2rem; } .is-notes h3 { margin:0; font-family:var(--font-display); font-size:1.25rem; letter-spacing:-.04em; } .is-notes li p { margin:.65rem 0 0; color:#526057; line-height:1.65; }
  .is-end { padding:clamp(5rem,11vw,11rem) 1.25rem; background:var(--sage); color:var(--ink); text-align:center; } .is-end .is-kicker { color:#42513d; } .is-end h2 { font-size:clamp(3.5rem,7vw,8rem); } .is-end a { margin-top:2.5rem; }
  @media (max-width:740px) { .is-hero__bar { grid-template-columns:1fr 1fr; } .is-hero__bar span:last-child { display:none; } .is-hero__grid,.is-response,.is-notes { grid-template-columns:1fr; } .is-hero__portrait { min-height:27rem; } .is-voices__cards,.is-editions__grid { grid-template-columns:1fr; } .is-voices blockquote { min-height:15rem; } .is-response__image { min-height:23rem; } }
</style>
