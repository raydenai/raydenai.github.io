---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const brand = (await getCollection('brand'))[0].data;
const directions = [
  { number: '01', title: 'Authority Film', route: '/directions/authority-film/', description: 'Cinematic, high-stakes, and narrative-led. The setting and the crucible do the work.', theme: 'film' },
  { number: '02', title: 'Proof Machine', route: '/directions/proof-machine/', description: 'Evidence-first, dense, and analytical. The record becomes the visual system.', theme: 'proof' },
  { number: '03', title: 'Idea Studio', route: '/directions/idea-studio/', description: 'Editorial, warm, and idea-led. The point of view is the hero.', theme: 'studio' },
];
---

<BaseLayout {brand} title="AURA Direction Review" description="Three upgraded personal-brand visual directions for review." transparentHeader={false} bodyClass="directions-index">
  <section class="di-hero"><p>AURA / visual direction review</p><h1>Do not choose<br />a <em>style.</em><br />Choose the<br />world the<br />brand owns.</h1><span>Three stronger routes,<br />each with a different<br />conversion psychology.</span></section>
  <section class="di-grid">{directions.map((direction) => <a class={`di-card di-card--${direction.theme}`} href={direction.route}><span class="di-card__number">{direction.number}</span><div><h2>{direction.title}</h2><p>{direction.description}</p><span class="di-card__cta">Open concept <b>↗</b></span></div></a>)}</section>
  <section class="di-note"><p>These are purposefully different systems, not color swaps. Choose the route that best matches the actual buyer, proof, and available photography. The full rationale lives in <a href="https://github.com/raydenai/raydenai.github.io/blob/main/docs/VISUAL_DIRECTION_OPTIONS.md">the visual direction brief</a>.</p></section>
</BaseLayout>

<style>
  :global(.directions-index) { background:#101114; color:#f4f0e7; } :global(.directions-index .announcement-bar) { display:none; } :global(.directions-index .site-header) { background:#101114; color:#f4f0e7; border-bottom:1px solid #444; } :global(.directions-index .site-header a) { color:#f4f0e7; } :global(.directions-index .site-footer) { background:#101114; border-top:1px solid #444; }
  .di-hero { position:relative; display:grid; grid-template-columns:1.3fr .7fr; gap:2rem; padding:clamp(5rem,12vw,12rem) clamp(1.25rem,8vw,9rem); border-bottom:1px solid #444; } .di-hero > p,.di-hero > span { font-family:var(--font-display); font-size:.62rem; font-weight:800; letter-spacing:.14em; line-height:1.6; text-transform:uppercase; } .di-hero > p { grid-column:1/-1; color:#d7ad53; } .di-hero h1 { max-width:9ch; margin:0; font-family:var(--font-display); font-size:clamp(3.5rem,9vw,10rem); font-weight:800; line-height:.8; letter-spacing:-.08em; text-transform:uppercase; } .di-hero h1 em { color:#d7ad53; font-family:var(--font-serif); font-weight:400; letter-spacing:-.1em; } .di-hero > span { align-self:end; color:#a7a39b; }
  .di-grid { display:grid; grid-template-columns:repeat(3,1fr); } .di-card { display:grid; min-height:37rem; grid-template-rows:auto 1fr; gap:2rem; padding:clamp(1.5rem,3vw,3rem); color:inherit; border-right:1px solid #444; transition:transform .35s ease; } .di-card:last-child { border-right:0; } .di-card:hover { transform:translateY(-.7rem); } .di-card__number { color:#b9b3a7; font-family:var(--font-display); font-size:.75rem; font-weight:800; letter-spacing:.13em; } .di-card > div { display:grid; align-content:end; } .di-card h2 { margin:0; font-family:var(--font-display); font-size:clamp(2.4rem,4vw,4.8rem); line-height:.87; letter-spacing:-.07em; } .di-card p { max-width:21rem; margin:1.6rem 0 0; font-size:.98rem; line-height:1.65; } .di-card__cta { margin-top:3rem; font-family:var(--font-display); font-size:.65rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; } .di-card--film { background:#15130f; } .di-card--film h2,.di-card--film .di-card__cta { color:#d7ad53; } .di-card--proof { background:#0b32a8; } .di-card--proof h2 { color:#f4f0e7; } .di-card--studio { background:#b5c49c; color:#1b2420; } .di-card--studio .di-card__number,.di-card--studio .di-card__cta { color:#426143; }
  .di-note { padding:clamp(3rem,7vw,7rem) clamp(1.25rem,8vw,9rem); border-top:1px solid #444; } .di-note p { max-width:50rem; margin:0; color:#cbc5b8; font-family:var(--font-serif); font-size:clamp(1.7rem,3vw,3rem); line-height:1.1; letter-spacing:-.045em; } .di-note a { color:#d7ad53; text-decoration:underline; text-underline-offset:.16em; }
  @media (max-width:720px) { .di-hero { grid-template-columns:1fr; } .di-hero > p { grid-column:auto; } .di-grid { grid-template-columns:1fr; } .di-card { min-height:22rem; border-right:0; border-bottom:1px solid #444; } }
</style>
