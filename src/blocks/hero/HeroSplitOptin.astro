---
/**
 * HeroSplitOptin
 * ---------------------------------------------------------------------------
 * Hero that captures an email above the fold instead of routing to a page.
 * Use when the primary conversion goal is `opt-in` or `subscribe`.
 *
 * Reference builds: Mike Dillard ("Join 125,000+ Subscribers"), Mike Burnett
 * ("Get Your Weekly Boost"), Jenna Phillips Ballard.
 *
 * Rule enforced here: exactly one action exists above the fold. No competing
 * secondary CTA — the corpus's highest conversion-clarity scores (9/10) all
 * came from heroes with a single action.
 */
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import BlockHeader from '../../components/primitives/BlockHeader.astro';
import Portrait from '../../components/primitives/Portrait.astro';
import Form from '../../components/primitives/Form.astro';

const {
  id,
  tone = 'default',
  pad = 'default',
  eyebrow,
  heading,
  mark,
  subheading,
  body,
  width = 'base',
  portrait,
  mediaSide = 'left',
  form,
  socialProofNote,
} = Astro.props;
---

<Section block="HeroSplitOptin" {id} {tone} {pad} grain glow class="hso">
  <Container {width}>
    <div class="u-split hso__split" data-media={mediaSide}>
      <div class="hso__copy">
        <BlockHeader
          {eyebrow}
          {heading}
          {mark}
          {subheading}
          {body}
          level={1}
          size="display-2"
        />

        <div class="hso__form">
          <Form
            action={form.action}
            fields={form.fields}
            submitLabel={form.submitLabel}
            consentNote={form.consentNote}
            layout={form.fields.length <= 2 ? 'inline' : 'stacked'}
          />
        </div>

        {socialProofNote && <p class="hso__note">{socialProofNote}</p>}
      </div>

      <div class="hso__media">
        <Portrait
          src={portrait.src}
          alt={portrait.alt}
          width={portrait.width}
          height={portrait.height}
          position={portrait.position}
          treatment="cutout"
          priority
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  .hso {
    overflow: clip;
  }
  .hso__split {
    position: relative;
    z-index: 2;
  }
  .hso__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .hso__form {
    max-width: 32rem;
  }
  .hso__note {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent);
  }
  @media (max-width: 899px) {
    .hso__media {
      order: 2;
      max-width: 22rem;
      margin-inline: auto;
    }
  }
</style>
