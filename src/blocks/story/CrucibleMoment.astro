---
/**
 * CrucibleMoment — one turning point, given the whole screen.
 * ---------------------------------------------------------------------------
 * The highest-leverage copy block found in the entire corpus. A single, dated,
 * sensory vignette of the moment everything changed:
 *
 *   Kathryn Janicek — "In 2007, I became the sole spokesperson during the
 *                      collapse of the 35W Bridge in Minneapolis."
 *   Christian Espinosa — "In 2022, pain in the back of my left leg sent me to
 *                      the ER. They found six blood clots that should have
 *                      killed me."
 *   Jenna Ballard   — "I woke up from a coma with brain damage."
 *   Karim Naoum     — "It started with a pink house and $5,000 down."
 *
 * Design intent: near-empty layout, oversized editorial type, no CTA. The block
 * deliberately gives the reader nothing to do except feel something. Every
 * competing element removed is a gain.
 *
 * Copy rules:
 *   - one moment only, never a summary of a career
 *   - include the year and a physical detail
 *   - end on the consequence, not the lesson
 */
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';

const {
  id,
  tone = 'inverse',
  pad = 'loose',
  eyebrow,
  width = 'content',
  moment,
  year,
  aftermath,
  background,
} = Astro.props;
---

<Section block="CrucibleMoment" {id} {tone} {pad} grain class="bcm">
  {
    background && (
      <div class="bcm__bg" aria-hidden="true">
        <img
          src={background.src}
          alt=""
          width={background.width ?? 1920}
          height={background.height ?? 1080}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <Container {width}>
    <figure class="bcm__figure">
      {year && <span class="bcm__year">{year}</span>}
      {eyebrow && <p class="bcm__eyebrow">{eyebrow}</p>}
      <blockquote class="bcm__moment">
        <p>{moment}</p>
      </blockquote>
      {aftermath && <figcaption class="bcm__aftermath">{aftermath}</figcaption>}
    </figure>
  </Container>
</Section>

<style>
  .bcm {
    overflow: clip;
  }
  .bcm__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.14;
  }
  .bcm__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .bcm .u-container {
    position: relative;
    z-index: 2;
  }
  .bcm__figure {
    margin: 0;
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .bcm__year {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-widest);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .bcm__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .bcm__moment {
    margin: 0;
    max-width: 32ch;
  }
  .bcm__moment p {
    font-family: var(--font-accent);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-normal);
    line-height: 1.14;
    letter-spacing: var(--ls-tight);
    text-transform: none;
    color: var(--text);
  }
  .bcm__aftermath {
    max-width: 52ch;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
</style>
