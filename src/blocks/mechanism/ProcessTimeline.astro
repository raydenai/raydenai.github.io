---
/**
 * ProcessTimeline — "here is exactly what happens next".
 * ---------------------------------------------------------------------------
 * Risk-reduction block. Placed immediately before an application or booking CTA
 * it removes the fear of an unknown sales process, which is the main reason
 * qualified visitors abandon high-ticket enquiry forms.
 */
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import BlockHeader from '../../components/primitives/BlockHeader.astro';

const {
  id,
  tone = 'raised',
  pad = 'default',
  eyebrow,
  heading,
  mark,
  subheading,
  body,
  ctas = [],
  align = 'start',
  width = 'content',
  steps = [],
} = Astro.props;
---

<Section block="ProcessTimeline" {id} {tone} {pad} class="bpt">
  <Container {width}>
    <div class="bpt__head">
      <BlockHeader {eyebrow} {heading} {mark} {subheading} {body} {ctas} {align} />
    </div>

    <ol class="bpt__list">
      {
        steps.map((step: any) => (
          <li class="bpt__step">
            <div class="bpt__marker" aria-hidden="true"></div>
            <div class="bpt__content">
              <div class="bpt__meta">
                <span class="bpt__label">{step.label}</span>
                {step.duration && <span class="bpt__duration">{step.duration}</span>}
              </div>
              <h3 class="bpt__title">{step.title}</h3>
              <p class="bpt__desc">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>

<style>
  .bpt__head {
    margin-bottom: var(--space-12);
  }
  .bpt__list {
    display: grid;
    gap: 0;
  }
  .bpt__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-5);
    padding-bottom: var(--space-10);
    position: relative;
  }
  .bpt__step:last-child {
    padding-bottom: 0;
  }
  .bpt__marker {
    position: relative;
    display: grid;
    place-items: start center;
  }
  .bpt__marker::before {
    content: '';
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.4rem;
    border-radius: var(--radius-circle);
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 18%, transparent);
  }
  .bpt__step:not(:last-child) .bpt__marker::after {
    content: '';
    position: absolute;
    top: 1.6rem;
    bottom: -0.6rem;
    width: 1px;
    background: var(--border-strong);
  }
  .bpt__content {
    display: grid;
    gap: var(--space-2);
  }
  .bpt__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .bpt__label {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--accent);
  }
  .bpt__duration {
    padding: 0.15em 0.6em;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }
  .bpt__title {
    font-size: var(--fs-lg);
    line-height: var(--lh-snug);
  }
  .bpt__desc {
    margin: 0;
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
    max-width: 58ch;
  }
</style>
