---
/**
 * PostsGrid — thought leadership + organic search surface.
 * ---------------------------------------------------------------------------
 * 53% of the corpus has a blog, but almost none of them use structured data or
 * answer-shaped headings, so they capture little search or AI-answer traffic.
 * This block reads directly from the typed `posts` collection and the page
 * layout emits Article/BlogPosting schema, closing that gap.
 */
import { getCollection } from 'astro:content';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import BlockHeader from '../../components/primitives/BlockHeader.astro';

const {
  id,
  tone = 'default',
  pad = 'default',
  eyebrow,
  heading,
  mark,
  subheading,
  body,
  ctas = [],
  align = 'start',
  width = 'wide',
  slugs = [],
  limit = 3,
} = Astro.props;

const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const posts =
  slugs.length > 0 ? all.filter((p) => slugs.includes(p.id)) : all.slice(0, limit);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

{
  posts.length > 0 && (
    <Section block="PostsGrid" {id} {tone} {pad} class="bpg">
      <Container {width}>
        <div class="bpg__head">
          <BlockHeader {eyebrow} {heading} {mark} {subheading} {body} {ctas} {align} />
        </div>

        <ul class="u-grid" style="--cols:3;--cols-tablet:2">
          {posts.map((post) => (
            <li>
              <a class="bpg__card" href={`/blog/${post.id}/`}>
                {post.data.cover && (
                  <img
                    class="bpg__image"
                    src={post.data.cover.src}
                    alt={post.data.cover.alt}
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="bpg__body">
                  <div class="bpg__meta">
                    {post.data.category && <span class="bpg__cat">{post.data.category}</span>}
                    <time datetime={post.data.publishDate.toISOString()}>
                      {dateFmt.format(post.data.publishDate)}
                    </time>
                  </div>
                  <h3 class="bpg__title">{post.data.title}</h3>
                  <p class="bpg__excerpt">{post.data.description}</p>
                  <span class="bpg__more">Read the article →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </Section>
  )
}

<style>
  .bpg__head {
    margin-bottom: var(--space-10);
  }
  .bpg__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--card-radius);
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .bpg__card:hover {
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    transform: translateY(-4px);
  }
  .bpg__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .bpg__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    flex: 1;
  }
  .bpg__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }
  .bpg__cat {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--accent);
  }
  .bpg__title {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .bpg__excerpt {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
  }
  .bpg__more {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
