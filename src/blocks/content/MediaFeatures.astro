---
/**
 * MediaFeatures — press, in detail.
 * ---------------------------------------------------------------------------
 * A LogoStrip claims coverage; this proves it with linked, dated articles. Use
 * both: the strip buys attention, this survives scrutiny from a journalist or
 * event booker doing diligence.
 */
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import BlockHeader from '../../components/primitives/BlockHeader.astro';

const {
  id,
  tone = 'raised',
  pad = 'default',
  eyebrow,
  heading,
  mark,
  subheading,
  body,
  ctas = [],
  align = 'start',
  width = 'base',
  features = [],
} = Astro.props;
---

<Section block="MediaFeatures" {id} {tone} {pad} class="bmd">
  <Container {width}>
    <div class="bmd__head">
      <BlockHeader {eyebrow} {heading} {mark} {subheading} {body} {ctas} {align} />
    </div>

    <ul class="bmd__list">
      {
        features.map((f: any) => (
          <li>
            <a class="bmd__item" href={f.href} rel="noopener noreferrer" target="_blank">
              {f.image && (
                <img
                  class="bmd__image"
                  src={f.image.src}
                  alt={f.image.alt}
                  width="160"
                  height="100"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="bmd__body">
                <span class="bmd__outlet">{f.outlet}</span>
                <span class="bmd__title">{f.title}</span>
                {f.date && <span class="bmd__date">{f.date}</span>}
              </span>
              <span class="bmd__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>

<style>
  .bmd__head {
    margin-bottom: var(--space-10);
  }
  .bmd__list {
    display: grid;
    border-top: 1px solid var(--border);
  }
  .bmd__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
    transition: padding-inline var(--dur-base) var(--ease-out);
  }
  .bmd__item:hover {
    padding-inline: var(--space-3);
    background: color-mix(in oklab, var(--accent) 5%, transparent);
  }
  .bmd__image {
    width: 5rem;
    height: 3.2rem;
    object-fit: cover;
    border-radius: var(--radius-xs);
  }
  .bmd__body {
    display: grid;
    gap: 0.25rem;
  }
  .bmd__outlet {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--accent);
  }
  .bmd__title {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  .bmd__date {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }
  .bmd__arrow {
    color: var(--text-subtle);
    font-size: var(--fs-lg);
    transition:
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .bmd__item:hover .bmd__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  @media (max-width: 640px) {
    .bmd__image {
      display: none;
    }
  }
</style>
