---
/**
 * CredibilityStack — titled credential grid.
 * ---------------------------------------------------------------------------
 * Where CredibilityBar shows scale, this shows *legitimacy*: education,
 * certifications, patents, awards, tenure.
 *
 * Reference: Christian Espinosa (Education / Advanced / Expertise / Innovation),
 * Jon Benson ("Inventor of the VSL"), Kathryn Janicek ("3x Emmy Award Winner").
 */
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import BlockHeader from '../../components/primitives/BlockHeader.astro';

const {
  id,
  tone = 'default',
  pad = 'default',
  eyebrow,
  heading,
  mark,
  subheading,
  body,
  ctas = [],
  align = 'start',
  width = 'base',
  credentials = [],
} = Astro.props;
---

<Section block="CredibilityStack" {id} {tone} {pad} class="bcs">
  <Container {width}>
    {
      (eyebrow || heading || body) && (
        <div class="bcs__head">
          <BlockHeader {eyebrow} {heading} {mark} {subheading} {body} {ctas} {align} />
        </div>
      )
    }
    <dl class="bcs__grid">
      {
        credentials.map((c: any) => (
          <div class="bcs__item">
            <dt class="bcs__title">{c.title}</dt>
            <dd class="bcs__value">{c.value}</dd>
            {c.detail && <dd class="bcs__detail">{c.detail}</dd>}
          </div>
        ))
      }
    </dl>
  </Container>
</Section>

<style>
  .bcs__head {
    margin-bottom: var(--space-12);
  }
  .bcs__grid {
    display: grid;
    gap: 1px;
    margin: 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--card-radius);
    overflow: hidden;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .bcs__item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(1.4rem, 1rem + 1.4vw, 2.25rem);
    background: var(--surface);
  }
  .bcs__title {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--accent);
  }
  .bcs__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  .bcs__detail {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--text-muted);
  }
</style>
