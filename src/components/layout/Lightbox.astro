---
/**
 * Lightbox — one dialog, shared by every block.
 * ---------------------------------------------------------------------------
 * This is the component that makes the system's performance profile possible.
 *
 * In the source corpus, video sections embedded a YouTube or Vimeo iframe per
 * thumbnail on initial load; each embed costs roughly 500KB-1MB of JS and
 * multiple third-party connections, and it was the single biggest reason the
 * corpus averaged 6.7/10 on technical performance despite good copy.
 *
 * Here, any element with [data-modal="video"] carrying a data-video or href is
 * intercepted and the iframe is constructed on click, with autoplay, inside a
 * native <dialog>. The cost on page load is zero bytes of third-party script.
 *
 * Also handles [data-modal="image"] (gallery) and [data-modal="form"].
 */
---

<dialog class="alb" aria-label="Media viewer">
  <button class="alb__close" type="button" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path
        d="M1 1l16 16M17 1L1 17"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <div class="alb__body"></div>
</dialog>

<style>
  .alb {
    width: min(94vw, 68rem);
    max-width: none;
    max-height: 90vh;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }
  .alb::backdrop {
    background: color-mix(in oklab, #000 82%, transparent);
    backdrop-filter: blur(6px);
  }
  .alb__body {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: var(--card-radius, 0.75rem);
    overflow: hidden;
  }
  .alb__body iframe,
  .alb__body video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .alb__body img {
    display: block;
    width: 100%;
    max-height: 86vh;
    object-fit: contain;
  }
  .alb__close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-circle, 50%);
    color: #fff;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .alb__close:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: rgb(255 255 255 / 0.6);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.alb');
  if (dialog) {
    const body = dialog.querySelector<HTMLElement>('.alb__body')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.alb__close')!;

    /** Convert a watch/share URL into an autoplaying embed URL. */
    const toEmbed = (raw: string): string => {
      try {
        const url = new URL(raw, window.location.origin);
        const host = url.hostname.replace(/^www\./, '');

        if (host === 'youtu.be') {
          return `https://www.youtube-nocookie.com/embed/${url.pathname.slice(1)}?autoplay=1&rel=0`;
        }
        if (host.endsWith('youtube.com')) {
          const id = url.searchParams.get('v') ?? url.pathname.split('/').pop();
          return `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        }
        if (host.endsWith('vimeo.com')) {
          const id = url.pathname.split('/').filter(Boolean).pop();
          return `https://player.vimeo.com/video/${id}?autoplay=1`;
        }
        if (host.endsWith('wistia.com') || host.endsWith('wistia.net')) {
          const id = url.pathname.split('/').filter(Boolean).pop();
          return `https://fast.wistia.net/embed/iframe/${id}?autoPlay=true`;
        }
        return raw;
      } catch {
        return raw;
      }
    };

    const open = (html: string) => {
      body.innerHTML = html;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    };

    const close = () => {
      dialog.close();
      body.innerHTML = '';
      document.documentElement.style.overflow = '';
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-modal]');
      if (!trigger) return;

      const kind = trigger.dataset.modal;
      if (!kind || kind === 'none') return;

      const src =
        trigger.dataset.video ??
        trigger.dataset.src ??
        trigger.getAttribute('href') ??
        '';
      if (!src || src === '#') return;

      event.preventDefault();

      if (kind === 'video') {
        const isFile = /\.(mp4|webm|mov)$/i.test(src);
        open(
          isFile
            ? `<video src="${src}" controls autoplay playsinline></video>`
            : `<iframe src="${toEmbed(src)}" title="Video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`,
        );
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'video_open', video_src: src });
      } else if (kind === 'image') {
        const alt = trigger.getAttribute('aria-label') ?? '';
        open(`<img src="${src}" alt="${alt.replace(/"/g, '&quot;')}">`);
      }
    });

    closeBtn.addEventListener('click', close);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    /* Click on the backdrop area closes. */
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  }
</script>
