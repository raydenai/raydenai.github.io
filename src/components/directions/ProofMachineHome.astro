  .pmh-ledger { display:grid; grid-template-columns:.65fr 1.35fr; gap:clamp(3rem,8vw,9rem); padding:clamp(5rem,11vw,11rem) clamp(1.25rem,7vw,8rem); background:#e7e5dc; color:#101114; } .pmh-ledger h2 { font-size:clamp(3.2rem,5.7vw,6.5rem); } .pmh-ledger__table { border-top:2px solid #101114; } .pmh-ledger__head,.pmh-ledger__table > div:not(.pmh-ledger__head) { display:grid; grid-template-columns:.85fr 1fr 1.1fr; gap:1rem; padding:1.1rem 0; border-bottom:1px solid #8f908a; } .pmh-ledger__head { color:#5d5f5c; font-family:var(--font-display); font-size:.55rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; } .pmh-ledger__table strong { font-family:var(--font-display); font-size:1rem; letter-spacing:-.03em; } .pmh-ledger__table p,.pmh-ledger__table small { margin:0; color:#555752; line-height:1.55; } .pmh-ledger__table small { font-size:.78rem; }
