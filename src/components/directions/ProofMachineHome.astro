  .pmh-intro { display:grid; grid-template-columns:1fr 1fr .45fr; gap:clamp(2rem,7vw,8rem); align-items:end; padding:clamp(5rem,11vw,11rem) clamp(1.25rem,7vw,8rem); background:#f1f1eb; color:#101114; } .pmh-intro h2 { max-width:8ch; font-size:clamp(3rem,5.9vw,6.8rem); } .pmh-intro > p { max-width:33rem; margin:0; color:#525458; font-size:1.05rem; line-height:1.75; } .pmh-intro__note { color:#0b32a8; font-family:var(--font-display); font-size:.56rem; font-weight:800; letter-spacing:.13em; line-height:1.55; text-transform:uppercase; }
