# Public build-time values. Copy to .env for local testing only.
# Do not place API keys, private email credentials, or any other secrets here.

# The final canonical URL after the domain is configured.
PUBLIC_SITE_URL=https://example.com

# Formspree (recommended static-site route): https://formspree.io/f/YOUR_FORM_ID
# The form ID is a public endpoint by design; configure domain restrictions and
# CAPTCHA in the provider dashboard. Leave blank to keep config://contact forms
# in safe demo mode.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Only explicitly approved origins may receive data from config://contact forms.
# List comma-separated origins, for example: https://formspree.io,https://api.hubapi.com
PUBLIC_FORM_ALLOWED_ORIGINS=https://formspree.io
